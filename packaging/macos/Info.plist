<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>Semisnip</string>
    <key>CFBundleDisplayName</key>
    <string>Semisnip</string>
    <key>CFBundleIdentifier</key>
    <string>com.semisnip.app</string>
    <key>CFBundleExecutable</key>
    <string>semisnip</string>
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSMinimumSystemVersion</key>
    <string>13.0</string>

    <!-- 关键：后台常驻 + 只弹非激活面板，不要 Dock 图标、不要菜单栏。
         不能用 LSBackgroundOnly —— 那会禁止一切窗口。
         注意这里只是启动瞬间的初值：gpui 启动时会把策略按自己的默认设回
         Regular，所以二进制里还会再调一次 set_activation_policy(Accessory)。 -->
    <key>LSUIElement</key>
    <true/>

    <key>NSHighResolutionCapable</key>
    <true/>

    <!-- CGEventTap 需要「辅助功能」授权，首次运行由系统弹窗引导。 -->
    <key>NSAppleEventsUsageDescription</key>
    <string>Semisnip 需要读取 espanso 的片段配置，并把选中的片段交给 espanso 展开。</string>
</dict>
</plist>
